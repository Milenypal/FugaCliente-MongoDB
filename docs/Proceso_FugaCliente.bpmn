<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="defs_fugacliente" targetNamespace="http://fugacliente.local/bpmn" exporter="FugaCliente">
  <bpmn:collaboration id="collab"><bpmn:participant id="pool" name="Empresa · Área de atención al cliente" processRef="proc_retencion"/></bpmn:collaboration>
  <bpmn:process id="proc_retencion" name="Gestión de incidencias y retención de clientes" isExecutable="false">
    <bpmn:laneSet id="laneset"><bpmn:lane id="lane_agente" name="Agente de atención"><bpmn:flowNodeRef>s1</bpmn:flowNodeRef><bpmn:flowNodeRef>t1</bpmn:flowNodeRef><bpmn:flowNodeRef>t6</bpmn:flowNodeRef><bpmn:flowNodeRef>t7</bpmn:flowNodeRef></bpmn:lane><bpmn:lane id="lane_sistema" name="Sistema FugaCliente"><bpmn:flowNodeRef>t2</bpmn:flowNodeRef><bpmn:flowNodeRef>t3</bpmn:flowNodeRef><bpmn:flowNodeRef>g1</bpmn:flowNodeRef><bpmn:flowNodeRef>t4</bpmn:flowNodeRef><bpmn:flowNodeRef>t8</bpmn:flowNodeRef></bpmn:lane><bpmn:lane id="lane_analista" name="Analista de retención"><bpmn:flowNodeRef>t5</bpmn:flowNodeRef><bpmn:flowNodeRef>g2</bpmn:flowNodeRef><bpmn:flowNodeRef>e1</bpmn:flowNodeRef></bpmn:lane></bpmn:laneSet>
    <bpmn:startEvent id="s1" name="Reclamo del cliente recibido"><bpmn:outgoing>f1</bpmn:outgoing><bpmn:messageEventDefinition id="med_s1"/></bpmn:startEvent><bpmn:userTask id="t1" name="Registrar incidencia"><bpmn:incoming>f1</bpmn:incoming><bpmn:outgoing>f2</bpmn:outgoing></bpmn:userTask><bpmn:serviceTask id="t2" name="Validar y guardar incidencia (SP transaccional)"><bpmn:incoming>f2</bpmn:incoming><bpmn:outgoing>f3</bpmn:outgoing></bpmn:serviceTask><bpmn:serviceTask id="t3" name="Calcular puntaje de riesgo"><bpmn:incoming>f3</bpmn:incoming><bpmn:outgoing>f4</bpmn:outgoing></bpmn:serviceTask><bpmn:exclusiveGateway id="g1" name="¿Riesgo medio o alto?"><bpmn:incoming>f4</bpmn:incoming><bpmn:outgoing>f5</bpmn:outgoing><bpmn:outgoing>f6</bpmn:outgoing></bpmn:exclusiveGateway><bpmn:serviceTask id="t4" name="Generar alerta de prioridad"><bpmn:incoming>f5</bpmn:incoming><bpmn:outgoing>f7</bpmn:outgoing></bpmn:serviceTask><bpmn:userTask id="t5" name="Asignar acción de retención"><bpmn:incoming>f7</bpmn:incoming><bpmn:incoming>f13</bpmn:incoming><bpmn:outgoing>f8</bpmn:outgoing></bpmn:userTask><bpmn:userTask id="t6" name="Contactar al cliente y ejecutar la acción"><bpmn:incoming>f8</bpmn:incoming><bpmn:outgoing>f9</bpmn:outgoing></bpmn:userTask><bpmn:userTask id="t7" name="Atender y resolver la incidencia"><bpmn:incoming>f6</bpmn:incoming><bpmn:incoming>f9</bpmn:incoming><bpmn:outgoing>f10</bpmn:outgoing></bpmn:userTask><bpmn:serviceTask id="t8" name="Recalcular riesgo y registrar auditoría"><bpmn:incoming>f10</bpmn:incoming><bpmn:outgoing>f11</bpmn:outgoing></bpmn:serviceTask><bpmn:exclusiveGateway id="g2" name="¿Riesgo controlado?"><bpmn:incoming>f11</bpmn:incoming><bpmn:outgoing>f12</bpmn:outgoing><bpmn:outgoing>f13</bpmn:outgoing></bpmn:exclusiveGateway><bpmn:endEvent id="e1" name="Cliente retenido"><bpmn:incoming>f12</bpmn:incoming></bpmn:endEvent><bpmn:sequenceFlow id="f1" name="" sourceRef="s1" targetRef="t1"/><bpmn:sequenceFlow id="f2" name="" sourceRef="t1" targetRef="t2"/><bpmn:sequenceFlow id="f3" name="" sourceRef="t2" targetRef="t3"/><bpmn:sequenceFlow id="f4" name="" sourceRef="t3" targetRef="g1"/><bpmn:sequenceFlow id="f5" name="Sí" sourceRef="g1" targetRef="t4"/><bpmn:sequenceFlow id="f6" name="No" sourceRef="g1" targetRef="t7"/><bpmn:sequenceFlow id="f7" name="" sourceRef="t4" targetRef="t5"/><bpmn:sequenceFlow id="f8" name="" sourceRef="t5" targetRef="t6"/><bpmn:sequenceFlow id="f9" name="" sourceRef="t6" targetRef="t7"/><bpmn:sequenceFlow id="f10" name="" sourceRef="t7" targetRef="t8"/><bpmn:sequenceFlow id="f11" name="" sourceRef="t8" targetRef="g2"/><bpmn:sequenceFlow id="f12" name="Sí" sourceRef="g2" targetRef="e1"/><bpmn:sequenceFlow id="f13" name="No" sourceRef="g2" targetRef="t5"/>
  </bpmn:process>
